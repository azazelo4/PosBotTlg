# Скопируйте в .env и заполните. Файл .env не коммитится.

# Telegram
TOKEN=

# Подключение бота к БД
DB_HOST=db
DB_USER=bot
DB_PASS=
DB_NAME=bot

# Контейнер MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=bot
MYSQL_USER=bot
MYSQL_PASSWORD=

# Телефон первого администратора: создаётся при старте, если его нет в БД
ADMIN_PHONE=
ADMIN_NAME=Администратор

# Часовой пояс магазинов (даты операций, отчёты, расписание)
TZ=Asia/Almaty

# Ежедневный отчёт (HH:MM). Без REPORT_CHAT_ID уходит всем администраторам
DAILY_REPORT_TIME=23:00
REPORT_CHAT_ID=

# Уведомление о низком остатке (HH:MM, пусто — выключено)
LOW_STOCK_TIME=09:00
LOW_STOCK_THRESHOLD=5

LOG_LEVEL=INFO
