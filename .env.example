# Скопируйте в .env и заполните. Файл .env не коммитится.

# Telegram
TOKEN=

# Подключение бота к БД
DB_HOST=db
DB_USER=bot
DB_PASS=
DB_NAME=bot

# Контейнер MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=bot
MYSQL_USER=bot
MYSQL_PASSWORD=

# Телефон первого администратора: создаётся при старте, если его нет в БД
ADMIN_PHONE=
ADMIN_NAME=Администратор

# Часовой пояс магазинов (даты операций, отчёты, расписание)
TZ=Asia/Almaty

# Ежедневный отчёт (HH:MM). Без REPORT_CHAT_ID уходит всем администраторам
DAILY_REPORT_TIME=23:00
REPORT_CHAT_ID=

# Уведомление о низком остатке (HH:MM, пусто — выключено)
LOW_STOCK_TIME=09:00
LOW_STOCK_THRESHOLD=5

LOG_LEVEL=INFO

# --- Веб-админка и Telegram Mini App (необязательно) ---
# Домен с A-записью на IP сервера. Включает сервисы web и caddy (HTTPS от Let's Encrypt).
# COMPOSE_PROFILES=web
# WEB_DOMAIN=pos.example.kz
# WEB_URL=https://pos.example.kz
# WEB_SECRET=длинная-случайная-строка

# --- Магазины ---
# Только для пустой базы: дальше магазины меняются в веб-админке
STORES=ЦУМ, Отау Сауда

# --- Ценники ---
LABEL_WIDTH_MM=30
LABEL_HEIGHT_MM=20
# Строка вверху ценника (название магазина). Пусто — магазин товара
LABEL_TITLE=

# --- Импорт каталога ---
# Минимальная цена в % от цены, если в файле её нет
IMPORT_MIN_PRICE_PERCENT=100
