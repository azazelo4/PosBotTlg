# Обычно этот файл вручную не нужен: deploy/bootstrap-env.sh создаёт .env сам
# (пароли БД и ключ шифрования генерируются один раз), а токен бота, магазины,
# администратор и остальные настройки задаются в мастере https://<домен>/setup.
#
# Локальный запуск:  cp .env.example .env && deploy/bootstrap-env.sh .env && docker compose up -d
# Файл .env не коммитится.

# --- База данных (bootstrap-env.sh заполнит пустые значения)
DB_HOST=db
DB_USER=bot
DB_PASS=
DB_NAME=bot
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=bot
MYSQL_USER=bot
MYSQL_PASSWORD=

# Ключ шифрования секретов в БД (токен бота, ключи Webkassa). Не теряйте и не меняйте:
# без него сохранённые секреты придётся ввести заново.
POSBOT_MASTER_KEY=
# Ключ подписи cookie веб-админки
WEB_SECRET=

# Часовой пояс контейнеров (логи). Часовой пояс магазина — в настройках веб-админки.
TZ=Asia/Almaty
LOG_LEVEL=INFO

# --- Необязательно. Любая настройка из веб-админки может быть задана здесь —
# тогда в админке она только для чтения. Например:
# TOKEN=
# WEB_URL=https://pos.example.kz
# ADMIN_PHONE=+77011234567
# LABEL_WIDTH_MM=30
# LABEL_HEIGHT_MM=20
